{
  // Node face: the plugin entry and its shared settings schema. Kept apart from
  // the client face because Host Context merges (agent, settings, session)
  // conflict with the Client session merge inside one program.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.host.tsbuildinfo"
  },
  "files": [
    "src/index.ts",
    "src/goal-settings.ts"
  ],
  "references": [
    {
      "path": "../../../vendor/cordis"
    },
    {
      "path": "../../../vendor/schemastery"
    },
    {
      "path": "../../settings/settings"
    },
    {
      "path": "../../core/agent"
    },
    {
      "path": "../../goal/goal"
    },
    {
      "path": "../../llm/llm"
    }
  ]
}
